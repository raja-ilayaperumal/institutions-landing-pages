    {
      "doc_type": "glossary",
      "title": "Office of Institutional Research and Planning (IRP) - Santa Barbara City College",
      "url": "https://www.sbcc.edu/institutionalresearch/",
      "summary": "The Office of Institutional Research and Planning at Santa Barbara City College supports and promotes a data-driven culture across the college to enhance mission-focused and student-centered improvements. It plays a key role in institutional effectiveness through participatory governance, data report production, institutional planning, and administering college surveys. It further oversees institutional grant administration, accreditation processes, and maintains the college's focus on centering student voices. The Office also provides resources through a Data Center and guides on applying for institutional grants.",
      "stored": false,
      "fetched_at": "2026-05-25T22:02:01.940369+05:30"
    },
    {
      "doc_type": "strategic_plan",
      "year": 2023,
      "title": "Santa Barbara City College Strategic Plan",
      "url": "https://www.sbcc.edu/institutionalresearch/files/planning-and-decision-making/SBCC-Strategy-Plan-061124-REVISED-FNL.pdf",
      "summary": "Santa Barbara City College's 2023 Strategic Plan sets forth a roadmap for nurturing an inclusive campus climate that values equity, agility, and resilience. The plan focuses on delivering high-quality, innovative educational programs while fostering community partnerships and ensuring environmental sustainability. Key initiatives include enhancing student support services, improving fiscal responsibility, and cultivating a collaborative culture that supports diversity and equity across all levels of the college community.",
      "stored": false,
