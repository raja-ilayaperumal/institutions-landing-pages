    {
      "doc_type": "strategic_plan",
      "year": 2026,
      "title": "OnePLNU",
      "url": "https://www.pointloma.edu/about/oneplnu",
      "summary": "The OnePLNU initiative by Point Loma Nazarene University is a strategic plan to assess opportunities and prepare for future challenges within the context of higher education. It focuses on cultivating a faith-centered mission, fostering a community of belonging, shaping a future-oriented academy, and stewarding resources wisely. The plan underscores the importance of innovation, engagement with diverse perspectives, and alignment with the university's core Christian values.",
