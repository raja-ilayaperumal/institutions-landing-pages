    {
      "doc_type": "strategic_plan",
      "year": 2024,
      "title": "Moorpark College Strategic Plan 2024-2025 to 2028-2029",
      "url": "https://www.moorparkcollege.edu/sites/moorparkcollege/files/media/file/2024-10/Moorpark%20College%20Strategic%20Plan%202024-2025%20to%202028-2029%20Leading%20and%20Lagging%20Indicators_0.pdf",
      "summary": "The Moorpark College Strategic Plan for 2024-2029 aims to enhance educational outcomes through five strategic directions: a student-centered curriculum, improved student access, increased student success, campus safety and wellness, and organizational effectiveness. Key initiatives include revising curricula to align with community needs, achieving equity in course success rates, and improving career support through tailored plans. The plan sets ambitious targets such as increasing degree completions by 30%, reducing degree completion units, and closing achievement gaps for underrepresented groups by 2028.",
      "stored": false,
